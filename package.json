{
  "name": "bb-plugin-android-emulator",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Android Emulator",
    "description": "See and control Android emulators on your bb hosts from a thread panel, with agent commands for the same device.",
    "branding": {
      "icon": "Smartphone"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "dependencies": {
    "@yume-chan/adb": "2.6.4",
    "@yume-chan/adb-scrcpy": "2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/scrcpy": "2.3.0",
    "@yume-chan/stream-extra": "2.6.1",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.2",
    "hono": "^4.11.9",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bb plugin build",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts && node i18n.test.mjs",
    "embed:scrcpy-server": "node scripts/embed-scrcpy-server.mjs",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolay-i/bb-plugin-android-emulator.git"
  },
  "bugs": {
    "url": "https://github.com/nicolay-i/bb-plugin-android-emulator/issues"
  },
  "homepage": "https://github.com/nicolay-i/bb-plugin-android-emulator#readme",
  "license": "MIT"
}
